# hermes/ponte-nexo.service — ponte local Hermes → Agência Nexo (instalar em /etc/systemd/system/).
# Escuta só em 127.0.0.1:8791; token em /etc/agencia-nexo/ponte.token (root:nexo 0640).
[Unit]
Description=Agência Nexo — ponte local para o perfil Hermes nexo
After=network.target nexo-egress-nft.service

[Service]
Type=simple
User=nexo
Group=nexo
Environment=AGENCIA_PONTE_TOKEN_ARQUIVO=/etc/agencia-nexo/ponte.token
Environment=AGENCIA_PONTE_PORTA=8791
ExecStart=/usr/bin/python3 /opt/agencia-nexo/hermes/ponte_nexo.py
Restart=on-failure
RestartSec=5
# As análises longas (nexo_run → codex exec) são filhas da ponte e podem levar horas: um restart da
# ponte não pode matá-las. Com control-group (padrão) o Codex morria e o run_*.json ficava sem .done.
KillMode=process

[Install]
WantedBy=multi-user.target
