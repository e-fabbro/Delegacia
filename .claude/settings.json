{
  "permissions": {
    "allow": [
      "Bash(python -m agencia:*)",
      "Bash(uv run python -m agencia:*)",
      "Read(//srv/casos/**)",
      "Edit(//srv/casos/**/03_analises/**)",
      "Edit(//srv/casos/**/04_produtos/**)"
    ],
    "deny": [
      "Read(//srv/casos/**/00_brutos/**)",
      "Read(//srv/casos/**/_cofre/**)",
      "Edit(//srv/casos/**/00_brutos/**)",
      "Edit(//srv/casos/**/_cofre/**)",
      "Read(./.env)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(nc:*)",
      "Bash(rm -rf:*)",
      "WebFetch",
      "WebSearch"
    ],
    "additionalDirectories": ["/srv/casos"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/guard_paths.py\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/audit_log.py\"" }]
      }
    ]
  }
}
